{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gpt-worker",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",

  // Secrets (never in this file): set with
  //   npx wrangler secret put ADMIN_TOKEN
  // `gpt-worker init` generates this once, machine/account-wide, and runs
  // this for you. The shared connector token and per-workspace gpt/link/cli
  // tokens are NOT Worker Secrets — their Durable Objects store them in the
  // secrets table, issued via POST /admin/<ADMIN_TOKEN>.

  "durable_objects": {
    "bindings": [
      { "name": "BRIDGE_DO", "class_name": "BridgeDO" }
    ]
  },

  // SQLite-backed Durable Objects are required on the Workers Free plan.
  // Do not change "new_sqlite_classes" to "new_classes" — that requires a
  // paid plan's classic (non-SQLite) storage backend.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BridgeDO"] }
  ],

  // src/instructions.js imports src/instructions.md as a plain string, and
  // src/index.js imports its dashboard browser assets (src/dashboard/*.html,
  // src/dashboard/*.js, src/dashboard/*.css) the same way. Node's test run resolves the same
  // imports through tests/helpers/text-modules.mjs. Each glob matches the
  // import specifier as written in source (e.g. "./instructions.md",
  // "./dashboard/workspace-app.js"), not a path relative to this config
  // file — a literal path here would never match. The dashboard globs are
  // scoped to that one directory (not "**/*.js") so no other Worker source
  // file is ever treated as a Text module instead of executable JS.
  "rules": [
    { "type": "Text", "globs": ["**/*.md", "**/dashboard/*.html", "**/dashboard/*.js", "**/dashboard/*.css"], "fallthrough": true }
  ]
}
